# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Environment / secrets
.env
.env.*
!.env.example

# ZCA-MT session / credential storage (opt-in feature — never commit these)
.zca-mt/
session.json
session*.json
credentials.json
credentials*.json
*.session.json
*.cookie.json
cookies.json

# QR codes (must never be persisted after login)
qr.png
qr-*.png
*.qr.png

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage / test artifacts
coverage/
.nyc_output/

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Package archives
*.tgz

# Lockfiles from other package managers (this project standardizes on npm)
bun.lock
bun.lockb
yarn.lock
pnpm-lock.yaml
