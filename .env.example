# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Comma-separated list of thread IDs (user or group) the example bot is
# allowed to respond in. Leave empty to disable the bot everywhere until
# configured. Do NOT put real thread IDs in source control.
ZCA_MT_ALLOWED_THREAD_IDS=

# Command prefix used by examples/basic-bot.ts
ZCA_MT_COMMAND_PREFIX=!

# Used by examples/production-bot.ts. Inject these values through your process
# manager/secret store; Node does not load this example file automatically.
ZCA_MT_SESSION_PATH=./.zca-mt/session.json
ZCA_MT_SESSION_PASSPHRASE=
ZCA_MT_FORCE_QR=0

# The production example fails closed when no allowed threads are configured.
# Use only thread IDs you are authorized to manage.
# ZCA_MT_ALLOWED_THREAD_IDS=thread-id-1,thread-id-2

# Optional: enable verbose zca-mt logging (redacted; safe for local dev).
ZCA_MT_LOGGING=true
