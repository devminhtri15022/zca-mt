{
    "name": "zca-mt",
    "version": "0.1.0",
    "description": "Unofficial Zalo API for JavaScript and TypeScript, developed from zca-js",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "index.d.ts",
    "exports": {
        ".": {
            "require": "./dist/cjs/index.cjs",
            "types": "./index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "index.d.ts",
        "README.md",
        "LICENSE",
        "NOTICE.md"
    ],
    "scripts": {
        "prebuild": "node scripts/buildAPI.js",
        "build:clean": "rimraf dist",
        "build:esm": "tsc",
        "build:cjs": "rollup -c rollup.config.js",
        "build": "npm run build:clean && npm run build:esm && npm run build:cjs",
        "clean": "rimraf dist",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/REPLACE_ME_WITH_YOUR_GITHUB_USERNAME/zca-mt.git"
    },
    "homepage": "https://github.com/REPLACE_ME_WITH_YOUR_GITHUB_USERNAME/zca-mt#readme",
    "bugs": {
        "url": "https://github.com/REPLACE_ME_WITH_YOUR_GITHUB_USERNAME/zca-mt/issues"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "keywords": [
        "zalo",
        "zca",
        "zca-mt",
        "api",
        "typescript",
        "nodejs"
    ],
    "author": "MT",
    "license": "MIT",
    "dependencies": {
        "crypto-js": "^4.2.0",
        "form-data": "^4.0.4",
        "json-bigint": "^1.0.0",
        "pako": "^2.1.0",
        "semver": "^7.6.3",
        "spark-md5": "^3.0.2",
        "tough-cookie": "^5.0.0",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.34.0",
        "@rollup/plugin-typescript": "^12.1.0",
        "@types/crypto-js": "^4.2.2",
        "@types/json-bigint": "^1.0.4",
        "@types/node": "20.14.10",
        "@types/pako": "^2.0.3",
        "@types/semver": "^7.5.8",
        "@types/spark-md5": "^3.0.4",
        "@types/ws": "^8.5.11",
        "eslint": "^9.34.0",
        "globals": "^16.3.0",
        "prettier": "^3.3.3",
        "rimraf": "^5.0.10",
        "rollup": "^4.24.0",
        "typescript": "5.5.3",
        "typescript-eslint": "^8.41.0",
        "vitest": "^2.1.4"
    }
}
